      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Datos de tu proyecto. Es el único nodo que hay que editar después de importar.\n// La anon key de Supabase es pública (la usa también la app): no es un secreto.\n// La clave de Gemini NO va acá: va en la credencial \"Gemini\" de n8n.\nconst config = {\n  supabaseUrl: 'https://TU-PROYECTO.supabase.co',\n  supabaseAnonKey: 'TU-ANON-KEY',\n  model: 'gemini-flash-latest',\n  embeddingModel: 'gemini-embedding-001',\n};\nreturn { json: { ...$json, config } };\n"
      }
    },
    {
      "id": "d5f315b7-2a9a-5316-8308-02b8da6c6482",
      "name": "Validar sesión",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.config.supabaseUrl }}/auth/v1/user",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $json.config.supabaseAnonKey }}"
            },
            {
              "name": "Authorization",
              "value": "={{ $json.headers.authorization ?? '' }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "text"
            }
          }
        }
      }
    },
    {
      "id": "d1310724-7fb1-59cc-a1b0-bf4fe89287f5",
      "name": "¿Sesión válida?",
      "type": "n8n-nodes-base.if",
