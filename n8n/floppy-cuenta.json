    {
      "id": "76db707e-b058-5f78-b077-70bc48dd16e8",
      "name": "Usuario",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -20
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// La persona a borrar es la dueña de la sesión: nunca un id que venga en el pedido.\nconst user = $json.body ? JSON.parse($json.body) : {};\nif (!user.id) throw new Error('Sesión sin usuario');\nif ($('Entrada desde la app').item.json.body?.confirm !== true) throw new Error('Falta confirm: true');\nreturn { json: { user_id: user.id } };\n"
      }
    },
    {
      "id": "58a12a0a-296d-57c0-bf81-30d66273c31f",
      "name": "Listar fotos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        -20
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuración').item.json.config.supabaseUrl }}/storage/v1/object/list/photos",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "text"
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ prefix: $json.user_id + \"/\", limit: 1000 }) }}"
      }
    },
    {
      "id": "93216fb6-4239-55bb-85b0-39ff4bbfe3b9",
      "name": "Rutas de las fotos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        -20
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Arma la lista de fotos de la persona para borrarlas del almacenamiento.\nconst uid = $('Usuario').item.json.user_id;\nconst lista = Array.isArray($json.body) ? $json.body : (() => { try { return JSON.parse($json.body ?? '[]'); } catch { return []; } })();\nreturn { json: { user_id: uid, prefixes: lista.filter((f) => f.name).map((f) => `${uid}/${f.name}`) } };\n"
      }
    },
    {
      "id": "9b0078ba-5e0e-578c-bf69-bbc629a5e145",
      "name": "Borrar fotos",
