# Copiá este archivo a .env y completá con los datos de tu proyecto.
# Sin estos valores la app arranca en modo demo, con datos de ejemplo.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY
# Dirección de tu n8n (en tu red: http://IP-DE-TU-COMPU:5678)
EXPO_PUBLIC_N8N_URL=http://192.168.0.10:5678
